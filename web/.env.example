# Copy to .env.local. The chat panel runs the Claude Agent SDK with this key; leave it
# out to use the Claude Code login on this Mac (`claude` → /login once).
# ANTHROPIC_API_KEY=sk-ant-...
# Which model the chat uses (default: claude-opus-5-5).
# BEATCUT_MODEL=claude-opus-5-5
# Where the beatcut folder is (default: the parent of web/).
# BEATCUT_ROOT=/Users/you/Desktop/beatcut
# ElevenLabs: the narration voice of the reformats (Text to Speech permission is enough).
# Without these the Mac's own voice (say -v Samantha) is used.
# ELEVENLABS_API_KEY=...
# ELEVENLABS_VOICE_ID=...
# ELEVENLABS_MODEL=eleven_multilingual_v2
# Higgsfield: generates the reacting avatar's clips (avatar <name> --image <url>), pay as you go.
# Console: open.higgsfield.ai → API keys (a key id and a secret).
# HF_KEY=key-id:key-secret        (as the console shows it; or HIGGSFIELD_KEY_ID + HIGGSFIELD_KEY_SECRET)
